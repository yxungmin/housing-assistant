{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "region_code": {
      "description": "거주 시도 코드",
      "type": "string",
      "minLength": 2
    },
    "age": {
      "type": "integer",
      "minimum": 0,
      "maximum": 120
    },
    "marriage": {
      "type": "string",
      "enum": [
        "single",
        "married",
        "pre_marriage",
        "single_parent"
      ]
    },
    "marriage_years": {
      "description": "혼인 기간 (년). 예비신혼부부는 0",
      "type": "number",
      "minimum": 0
    },
    "household_size": {
      "type": "integer",
      "minimum": 1,
      "maximum": 10
    },
    "children_count": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "children_ages": {
      "type": "array",
      "items": {
        "type": "integer",
        "minimum": 0,
        "maximum": 9007199254740991
      }
    },
    "income_type": {
      "type": "string",
      "enum": [
        "single",
        "dual"
      ]
    },
    "monthly_income": {
      "description": "가구 월평균소득 (원, 세전)",
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "total_assets": {
      "description": "총자산 (원)",
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "car_value": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "monthly_debt_payment": {
      "description": "기존 부채 월 상환액 (원)",
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "homeless_months": {
      "description": "무주택 기간 (개월). 유주택자는 undefined",
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "is_homeless": {
      "type": "boolean"
    },
    "subscription_months": {
      "description": "청약통장 가입기간 (개월)",
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "subscription_deposits": {
      "description": "납입 횟수",
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "cash_on_hand": {
      "description": "보유 현금 (원)",
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "workplace": {
      "type": "object",
      "properties": {
        "label": {
          "type": "string"
        },
        "lat": {
          "type": "number"
        },
        "lng": {
          "type": "number"
        }
      },
      "required": [
        "lat",
        "lng"
      ]
    },
    "commute_limit_min": {
      "description": "허용 통근 시간 상한 (분)",
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    }
  }
}
