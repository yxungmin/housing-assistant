{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "region_code": {
      "description": "거주 시도 코드 (11 서울, 41 경기 …)",
      "type": "string",
      "minLength": 2
    },
    "region_sigungu": {
      "description": "거주 시군구 \"시도약칭 시군구\" 형식 (예: \"경기 과천시\")",
      "type": "string"
    },
    "birth_date": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "age": {
      "type": "integer",
      "minimum": 0,
      "maximum": 120
    },
    "marriage": {
      "type": "string",
      "enum": [
        "single",
        "married",
        "pre_marriage",
        "single_parent"
      ]
    },
    "marriage_years": {
      "description": "혼인 기간 (년). 예비신혼부부는 0",
      "type": "number",
      "minimum": 0
    },
    "household_size": {
      "type": "integer",
      "minimum": 1,
      "maximum": 10
    },
    "children_count": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "children_ages": {
      "type": "array",
      "items": {
        "type": "integer",
        "minimum": 0,
        "maximum": 9007199254740991
      }
    },
    "income_type": {
      "type": "string",
      "enum": [
        "single",
        "dual"
      ]
    },
    "monthly_income": {
      "description": "가구 월평균소득 (원, 세전)",
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "total_assets": {
      "description": "총자산 (원)",
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "car_value": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "monthly_debt_payment": {
      "description": "기존 부채 월 상환액 (원)",
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "homeless_months": {
      "description": "무주택 기간 (개월). 유주택자는 undefined",
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "is_homeless": {
      "type": "boolean"
    },
    "subscription_months": {
      "description": "청약통장 가입기간 (개월, subscription_as_of 기준)",
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "subscription_deposits": {
      "description": "납입 횟수 (subscription_as_of 기준)",
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "subscription_as_of": {
      "description": "위 두 값을 입력한 날. 납입 중이면 이후 지난 달수를 더한다",
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "subscription_active": {
      "description": "지금도 매달 납입 중인가",
      "type": "boolean"
    },
    "cash_on_hand": {
      "description": "보유 현금 (원)",
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "statuses": {
      "description": "해당하는 계층 자격. 빈 배열 = 해당 없음, undefined = 미입력",
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "student",
          "job_seeker",
          "new_worker",
          "artist",
          "welfare_recipient",
          "basic_livelihood",
          "national_merit",
          "disabled",
          "nk_defector",
          "single_parent_support",
          "elderly_care",
          "care_leaver",
          "creator"
        ]
      }
    },
    "workplace": {
      "type": "object",
      "properties": {
        "label": {
          "type": "string"
        },
        "lat": {
          "type": "number"
        },
        "lng": {
          "type": "number"
        }
      },
      "required": [
        "lat",
        "lng"
      ]
    },
    "workplace_partner": {
      "type": "object",
      "properties": {
        "label": {
          "type": "string"
        },
        "lat": {
          "type": "number"
        },
        "lng": {
          "type": "number"
        }
      },
      "required": [
        "lat",
        "lng"
      ]
    },
    "commute_limit_min": {
      "description": "허용 통근 시간 상한 (분)",
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    }
  }
}
