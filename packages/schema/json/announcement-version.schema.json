{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "format": "uuid",
      "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
    },
    "announcement_id": {
      "type": "string",
      "format": "uuid",
      "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
    },
    "version": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "status": {
      "type": "string",
      "enum": [
        "UNVERIFIED",
        "VERIFIED",
        "CONFLICT"
      ]
    },
    "source_modified_at": {
      "type": "string"
    },
    "extracted_at": {
      "type": "string"
    },
    "verified_at": {
      "type": "string"
    },
    "conflict_reasons": {
      "default": [],
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "extraction": {
      "type": "object",
      "properties": {
        "title": {
          "type": "string",
          "minLength": 1
        },
        "housing_type": {
          "type": "string",
          "enum": [
            "happy",
            "national_rental",
            "newlywed_hope",
            "purchased_rental",
            "public_sale",
            "long_term_rental",
            "other"
          ]
        },
        "address": {
          "description": "단지 주소 (도로명 또는 지번)",
          "type": "string"
        },
        "schedule": {
          "type": "object",
          "properties": {
            "notice_date": {
              "description": "공고일 YYYY-MM-DD",
              "type": "string"
            },
            "apply_start": {
              "description": "접수 시작 YYYY-MM-DD",
              "type": "string"
            },
            "apply_end": {
              "description": "접수 종료 YYYY-MM-DD",
              "type": "string"
            },
            "winner_announce": {
              "type": "string"
            },
            "move_in": {
              "description": "입주 예정 (YYYY-MM 또는 원문 표현)",
              "type": "string"
            },
            "documents_announce": {
              "description": "서류제출 대상자 발표 YYYY-MM-DD",
              "type": "string"
            },
            "documents_start": {
              "description": "서류 제출 시작 YYYY-MM-DD",
              "type": "string"
            },
            "documents_end": {
              "description": "서류 제출 마감 YYYY-MM-DD",
              "type": "string"
            },
            "contract_start": {
              "description": "계약 시작 YYYY-MM-DD",
              "type": "string"
            },
            "contract_end": {
              "description": "계약 마감 YYYY-MM-DD",
              "type": "string"
            }
          }
        },
        "application": {
          "type": "object",
          "properties": {
            "online": {
              "description": "인터넷·모바일 접수가 되는가",
              "type": "boolean"
            },
            "onsite": {
              "description": "현장 접수가 되는가",
              "type": "boolean"
            },
            "onsite_for": {
              "description": "현장 접수가 일부 대상에게만 되면 그 대상 (예: 65세 이상·장애인)",
              "type": "string",
              "maxLength": 80
            },
            "place": {
              "description": "현장 접수 장소",
              "type": "string",
              "maxLength": 120
            },
            "source": {
              "type": "object",
              "properties": {
                "page": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 9007199254740991,
                  "description": "공고문 PDF 페이지 (1부터)"
                },
                "text": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 500,
                  "description": "근거가 되는 원문 발췌"
                }
              },
              "required": [
                "page",
                "text"
              ]
            }
          }
        },
        "tracks": {
          "minItems": 1,
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1,
                "description": "공급 트랙 이름 (예: 신혼부부 우선공급, 일반공급)"
              },
              "households": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "unit_types": {
                "default": [],
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "name": {
                      "type": "string",
                      "minLength": 1,
                      "description": "주택형 이름 (예: 26A, 36, 55)"
                    },
                    "exclusive_area_m2": {
                      "type": "number",
                      "exclusiveMinimum": 0
                    },
                    "households": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 9007199254740991
                    }
                  },
                  "required": [
                    "name"
                  ]
                }
              },
              "rule_groups": {
                "default": [],
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "id": {
                      "type": "string",
                      "minLength": 1,
                      "description": "트랙 안에서 유일한 그룹 id (예: newlywed_status)"
                    },
                    "mode": {
                      "type": "string",
                      "enum": [
                        "all_of",
                        "any_of"
                      ]
                    },
                    "label": {
                      "type": "string",
                      "minLength": 1,
                      "description": "사용자에게 보이는 그룹 이름 (예: 신혼부부 자격)"
                    }
                  },
                  "required": [
                    "id",
                    "mode",
                    "label"
                  ]
                }
              },
              "rules": {
                "default": [],
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "group_id": {
                      "type": "string",
                      "minLength": 1
                    },
                    "category": {
                      "type": "string",
                      "enum": [
                        "income",
                        "asset",
                        "car_value",
                        "debt",
                        "residence",
                        "housing",
                        "marriage",
                        "children",
                        "age",
                        "subscription",
                        "commute",
                        "status"
                      ]
                    },
                    "applies_to": {
                      "default": {},
                      "type": "object",
                      "properties": {
                        "household_size": {
                          "description": "가구원 수 (정확히 이 값)",
                          "type": "integer",
                          "minimum": 1,
                          "maximum": 10
                        },
                        "household_size_min": {
                          "type": "integer",
                          "minimum": 1,
                          "maximum": 9007199254740991
                        },
                        "household_size_max": {
                          "type": "integer",
                          "minimum": 1,
                          "maximum": 9007199254740991
                        },
                        "income_type": {
                          "type": "string",
                          "enum": [
                            "single",
                            "dual"
                          ]
                        },
                        "marriage": {
                          "type": "array",
                          "items": {
                            "type": "string",
                            "enum": [
                              "single",
                              "married",
                              "pre_marriage",
                              "single_parent"
                            ]
                          }
                        }
                      },
                      "additionalProperties": false
                    },
                    "operator": {
                      "type": "string",
                      "enum": [
                        "eq",
                        "lte",
                        "gte",
                        "between",
                        "in",
                        "is_true"
                      ]
                    },
                    "value": {
                      "anyOf": [
                        {
                          "type": "number"
                        },
                        {
                          "type": "string"
                        },
                        {
                          "type": "boolean",
                          "const": true
                        },
                        {
                          "minItems": 1,
                          "type": "array",
                          "items": {
                            "type": "string"
                          },
                          "description": "in: 허용 값 목록"
                        },
                        {
                          "minItems": 1,
                          "type": "array",
                          "items": {
                            "type": "number"
                          },
                          "description": "between: [min, max] / in: 허용 숫자 목록"
                        }
                      ]
                    },
                    "unit": {
                      "description": "KRW_monthly, KRW, years, months, count, minutes, region_code ...",
                      "type": "string"
                    },
                    "source": {
                      "type": "object",
                      "properties": {
                        "page": {
                          "type": "integer",
                          "minimum": 1,
                          "maximum": 9007199254740991,
                          "description": "공고문 PDF 페이지 (1부터)"
                        },
                        "text": {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 500,
                          "description": "근거가 되는 원문 발췌"
                        }
                      },
                      "required": [
                        "page",
                        "text"
                      ]
                    },
                    "confidence": {
                      "type": "number",
                      "minimum": 0,
                      "maximum": 1
                    },
                    "verified": {
                      "default": false,
                      "type": "boolean"
                    },
                    "bonuses": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "newborn_children_min": {
                            "type": "integer",
                            "minimum": 1,
                            "maximum": 9007199254740991,
                            "description": "2023.3.28 이후 출산(입양·태아 포함) 미성년 자녀 수가 이 값 이상이면"
                          },
                          "value": {
                            "type": "number",
                            "description": "완화된 상한 (원 또는 원/월, 룰의 unit과 같음)"
                          }
                        },
                        "required": [
                          "newborn_children_min",
                          "value"
                        ]
                      }
                    }
                  },
                  "required": [
                    "group_id",
                    "category",
                    "operator",
                    "value",
                    "source",
                    "confidence"
                  ]
                }
              },
              "pricing": {
                "default": [],
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "unit_type": {
                      "type": "string",
                      "minLength": 1
                    },
                    "tier": {
                      "description": "같은 주택형 안에서 임대조건이 갈리는 계층 (예: 소득있는 청년, 고령자). 트랙 전체에 같으면 생략",
                      "type": "string"
                    },
                    "kind": {
                      "type": "string",
                      "enum": [
                        "rental",
                        "sale"
                      ]
                    },
                    "deposit": {
                      "description": "임대보증금 (원)",
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 9007199254740991
                    },
                    "monthly_rent": {
                      "description": "월임대료 (원)",
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 9007199254740991
                    },
                    "sale_price": {
                      "description": "분양가 (원)",
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 9007199254740991
                    },
                    "conversion": {
                      "type": "object",
                      "properties": {
                        "rate": {
                          "type": "number",
                          "minimum": 0,
                          "maximum": 1,
                          "description": "보증금 증액(월세 감액) 전환 이율 (연, 0.07 = 7%)"
                        },
                        "rate_down": {
                          "description": "보증금 감액(월세 증액) 전환 이율. 없으면 rate와 같음",
                          "type": "number",
                          "minimum": 0,
                          "maximum": 1
                        },
                        "max_deposit": {
                          "description": "최대 전환 시 보증금 상한 (원)",
                          "type": "integer",
                          "minimum": 0,
                          "maximum": 9007199254740991
                        },
                        "min_deposit": {
                          "description": "최대 전환 시 보증금 하한 (원)",
                          "type": "integer",
                          "minimum": 0,
                          "maximum": 9007199254740991
                        }
                      },
                      "required": [
                        "rate"
                      ]
                    },
                    "payment_schedule": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "label": {
                            "type": "string",
                            "minLength": 1,
                            "description": "계약금 / 중도금 1회 / 잔금 ..."
                          },
                          "ratio": {
                            "type": "number",
                            "minimum": 0,
                            "maximum": 1
                          },
                          "due": {
                            "description": "YYYY-MM-DD 또는 '입주지정일' 같은 원문 표현",
                            "type": "string"
                          }
                        },
                        "required": [
                          "label",
                          "ratio"
                        ]
                      }
                    },
                    "maintenance_estimate": {
                      "description": "관리비 추정 (원/월)",
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 9007199254740991
                    },
                    "source": {
                      "type": "object",
                      "properties": {
                        "page": {
                          "type": "integer",
                          "minimum": 1,
                          "maximum": 9007199254740991,
                          "description": "공고문 PDF 페이지 (1부터)"
                        },
                        "text": {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 500,
                          "description": "근거가 되는 원문 발췌"
                        }
                      },
                      "required": [
                        "page",
                        "text"
                      ]
                    }
                  },
                  "required": [
                    "unit_type",
                    "kind",
                    "source"
                  ]
                }
              },
              "priority_ranks": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "rank": {
                      "type": "integer",
                      "minimum": 1,
                      "maximum": 9,
                      "description": "순위 (1 = 1순위)"
                    },
                    "label": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 120,
                      "description": "원문 요약 (예: 양산시 거주자)"
                    },
                    "mode": {
                      "default": "all_of",
                      "type": "string",
                      "enum": [
                        "all_of",
                        "any_of"
                      ]
                    },
                    "conditions": {
                      "default": [],
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "category": {
                            "type": "string",
                            "enum": [
                              "income",
                              "asset",
                              "car_value",
                              "debt",
                              "residence",
                              "housing",
                              "marriage",
                              "children",
                              "age",
                              "subscription",
                              "commute",
                              "status"
                            ]
                          },
                          "applies_to": {
                            "default": {},
                            "type": "object",
                            "properties": {
                              "household_size": {
                                "description": "가구원 수 (정확히 이 값)",
                                "type": "integer",
                                "minimum": 1,
                                "maximum": 10
                              },
                              "household_size_min": {
                                "type": "integer",
                                "minimum": 1,
                                "maximum": 9007199254740991
                              },
                              "household_size_max": {
                                "type": "integer",
                                "minimum": 1,
                                "maximum": 9007199254740991
                              },
                              "income_type": {
                                "type": "string",
                                "enum": [
                                  "single",
                                  "dual"
                                ]
                              },
                              "marriage": {
                                "type": "array",
                                "items": {
                                  "type": "string",
                                  "enum": [
                                    "single",
                                    "married",
                                    "pre_marriage",
                                    "single_parent"
                                  ]
                                }
                              }
                            },
                            "additionalProperties": false
                          },
                          "operator": {
                            "type": "string",
                            "enum": [
                              "eq",
                              "lte",
                              "gte",
                              "between",
                              "in",
                              "is_true"
                            ]
                          },
                          "value": {
                            "anyOf": [
                              {
                                "type": "number"
                              },
                              {
                                "type": "string"
                              },
                              {
                                "type": "boolean",
                                "const": true
                              },
                              {
                                "minItems": 1,
                                "type": "array",
                                "items": {
                                  "type": "string"
                                },
                                "description": "in: 허용 값 목록"
                              },
                              {
                                "minItems": 1,
                                "type": "array",
                                "items": {
                                  "type": "number"
                                },
                                "description": "between: [min, max] / in: 허용 숫자 목록"
                              }
                            ]
                          },
                          "unit": {
                            "type": "string"
                          }
                        },
                        "required": [
                          "category",
                          "operator",
                          "value"
                        ]
                      }
                    },
                    "apply_date": {
                      "description": "이 순위의 접수일 YYYY-MM-DD",
                      "type": "string"
                    },
                    "source": {
                      "type": "object",
                      "properties": {
                        "page": {
                          "type": "integer",
                          "minimum": 1,
                          "maximum": 9007199254740991,
                          "description": "공고문 PDF 페이지 (1부터)"
                        },
                        "text": {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 500,
                          "description": "근거가 되는 원문 발췌"
                        }
                      },
                      "required": [
                        "page",
                        "text"
                      ]
                    }
                  },
                  "required": [
                    "rank",
                    "label",
                    "source"
                  ]
                }
              },
              "selection_order": {
                "type": "array",
                "items": {
                  "type": "string",
                  "enum": [
                    "rank",
                    "score",
                    "lottery"
                  ]
                }
              },
              "residence": {
                "type": "object",
                "properties": {
                  "contract_years": {
                    "description": "한 번 계약 기간 (년)",
                    "type": "number",
                    "exclusiveMinimum": 0
                  },
                  "max_years": {
                    "description": "재계약 포함 최장 거주 기간 (년)",
                    "type": "number",
                    "exclusiveMinimum": 0
                  },
                  "note": {
                    "description": "자녀 수 등으로 달라지면 그 조건 (원문 요약)",
                    "type": "string",
                    "maxLength": 120
                  }
                }
              }
            },
            "required": [
              "name"
            ]
          }
        },
        "notes": {
          "default": [],
          "description": "구조화하지 못한 중요 조건의 원문 발췌",
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "title",
        "housing_type",
        "schedule",
        "tracks"
      ]
    }
  },
  "required": [
    "announcement_id",
    "version",
    "status",
    "extracted_at",
    "extraction"
  ]
}
