{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "title": {
      "type": "string",
      "minLength": 1
    },
    "housing_type": {
      "type": "string",
      "enum": [
        "happy",
        "national_rental",
        "newlywed_hope",
        "purchased_rental",
        "public_sale",
        "long_term_rental",
        "other"
      ]
    },
    "address": {
      "description": "단지 주소 (도로명 또는 지번)",
      "type": "string"
    },
    "schedule": {
      "type": "object",
      "properties": {
        "notice_date": {
          "description": "공고일 YYYY-MM-DD",
          "type": "string"
        },
        "apply_start": {
          "description": "접수 시작 YYYY-MM-DD",
          "type": "string"
        },
        "apply_end": {
          "description": "접수 종료 YYYY-MM-DD",
          "type": "string"
        },
        "winner_announce": {
          "type": "string"
        },
        "move_in": {
          "description": "입주 예정 (YYYY-MM 또는 원문 표현)",
          "type": "string"
        }
      }
    },
    "tracks": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "description": "공급 트랙 이름 (예: 신혼부부 우선공급, 일반공급)"
          },
          "households": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "unit_types": {
            "default": [],
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "name": {
                  "type": "string",
                  "minLength": 1,
                  "description": "주택형 이름 (예: 26A, 36, 55)"
                },
                "exclusive_area_m2": {
                  "type": "number",
                  "exclusiveMinimum": 0
                },
                "households": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                }
              },
              "required": [
                "name"
              ]
            }
          },
          "rule_groups": {
            "default": [],
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string",
                  "minLength": 1,
                  "description": "트랙 안에서 유일한 그룹 id (예: newlywed_status)"
                },
                "mode": {
                  "type": "string",
                  "enum": [
                    "all_of",
                    "any_of"
                  ]
                },
                "label": {
                  "type": "string",
                  "minLength": 1,
                  "description": "사용자에게 보이는 그룹 이름 (예: 신혼부부 자격)"
                }
              },
              "required": [
                "id",
                "mode",
                "label"
              ]
            }
          },
          "rules": {
            "default": [],
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "group_id": {
                  "type": "string",
                  "minLength": 1
                },
                "category": {
                  "type": "string",
                  "enum": [
                    "income",
                    "asset",
                    "car_value",
                    "debt",
                    "residence",
                    "housing",
                    "marriage",
                    "children",
                    "age",
                    "subscription",
                    "commute"
                  ]
                },
                "applies_to": {
                  "default": {},
                  "type": "object",
                  "properties": {
                    "household_size": {
                      "description": "가구원 수 (정확히 이 값)",
                      "type": "integer",
                      "minimum": 1,
                      "maximum": 10
                    },
                    "household_size_min": {
                      "type": "integer",
                      "minimum": 1,
                      "maximum": 9007199254740991
                    },
                    "household_size_max": {
                      "type": "integer",
                      "minimum": 1,
                      "maximum": 9007199254740991
                    },
                    "income_type": {
                      "type": "string",
                      "enum": [
                        "single",
                        "dual"
                      ]
                    },
                    "marriage": {
                      "type": "array",
                      "items": {
                        "type": "string",
                        "enum": [
                          "single",
                          "married",
                          "pre_marriage",
                          "single_parent"
                        ]
                      }
                    }
                  },
                  "additionalProperties": false
                },
                "operator": {
                  "type": "string",
                  "enum": [
                    "eq",
                    "lte",
                    "gte",
                    "between",
                    "in",
                    "is_true"
                  ]
                },
                "value": {
                  "anyOf": [
                    {
                      "type": "number"
                    },
                    {
                      "type": "string"
                    },
                    {
                      "type": "boolean",
                      "const": true
                    },
                    {
                      "type": "array",
                      "prefixItems": [
                        {
                          "type": "number"
                        },
                        {
                          "type": "number"
                        }
                      ],
                      "items": false,
                      "minItems": 2,
                      "maxItems": 2
                    },
                    {
                      "minItems": 1,
                      "type": "array",
                      "items": {
                        "type": "string"
                      }
                    },
                    {
                      "minItems": 1,
                      "type": "array",
                      "items": {
                        "type": "number"
                      }
                    }
                  ]
                },
                "unit": {
                  "description": "KRW_monthly, KRW, years, months, count, minutes, region_code ...",
                  "type": "string"
                },
                "source": {
                  "type": "object",
                  "properties": {
                    "page": {
                      "type": "integer",
                      "minimum": 1,
                      "maximum": 9007199254740991,
                      "description": "공고문 PDF 페이지 (1부터)"
                    },
                    "text": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 500,
                      "description": "근거가 되는 원문 발췌"
                    }
                  },
                  "required": [
                    "page",
                    "text"
                  ]
                },
                "confidence": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1
                },
                "verified": {
                  "default": false,
                  "type": "boolean"
                }
              },
              "required": [
                "group_id",
                "category",
                "operator",
                "value",
                "source",
                "confidence"
              ]
            }
          },
          "pricing": {
            "default": [],
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "unit_type": {
                  "type": "string",
                  "minLength": 1
                },
                "tier": {
                  "description": "같은 주택형 안에서 임대조건이 갈리는 계층 (예: 소득있는 청년, 고령자). 트랙 전체에 같으면 생략",
                  "type": "string"
                },
                "kind": {
                  "type": "string",
                  "enum": [
                    "rental",
                    "sale"
                  ]
                },
                "deposit": {
                  "description": "임대보증금 (원)",
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                },
                "monthly_rent": {
                  "description": "월임대료 (원)",
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                },
                "sale_price": {
                  "description": "분양가 (원)",
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                },
                "conversion": {
                  "type": "object",
                  "properties": {
                    "rate": {
                      "type": "number",
                      "minimum": 0,
                      "maximum": 1,
                      "description": "보증금 증액(월세 감액) 전환 이율 (연, 0.07 = 7%)"
                    },
                    "rate_down": {
                      "description": "보증금 감액(월세 증액) 전환 이율. 없으면 rate와 같음",
                      "type": "number",
                      "minimum": 0,
                      "maximum": 1
                    },
                    "max_deposit": {
                      "description": "최대 전환 시 보증금 상한 (원)",
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 9007199254740991
                    },
                    "min_deposit": {
                      "description": "최대 전환 시 보증금 하한 (원)",
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 9007199254740991
                    }
                  },
                  "required": [
                    "rate"
                  ]
                },
                "payment_schedule": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "label": {
                        "type": "string",
                        "minLength": 1,
                        "description": "계약금 / 중도금 1회 / 잔금 ..."
                      },
                      "ratio": {
                        "type": "number",
                        "minimum": 0,
                        "maximum": 1
                      },
                      "due": {
                        "description": "YYYY-MM-DD 또는 '입주지정일' 같은 원문 표현",
                        "type": "string"
                      }
                    },
                    "required": [
                      "label",
                      "ratio"
                    ]
                  }
                },
                "maintenance_estimate": {
                  "description": "관리비 추정 (원/월)",
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                },
                "source": {
                  "type": "object",
                  "properties": {
                    "page": {
                      "type": "integer",
                      "minimum": 1,
                      "maximum": 9007199254740991,
                      "description": "공고문 PDF 페이지 (1부터)"
                    },
                    "text": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 500,
                      "description": "근거가 되는 원문 발췌"
                    }
                  },
                  "required": [
                    "page",
                    "text"
                  ]
                }
              },
              "required": [
                "unit_type",
                "kind",
                "source"
              ]
            }
          }
        },
        "required": [
          "name"
        ]
      }
    },
    "notes": {
      "default": [],
      "description": "구조화하지 못한 중요 조건의 원문 발췌",
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "required": [
    "title",
    "housing_type",
    "schedule",
    "tracks"
  ]
}
