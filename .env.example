# LH 분양임대공고 Open API (공공데이터포털 data.go.kr) 인증키
LH_API_KEY=

# Supabase (수집기는 service role 키로 쓰기)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# LLM 추출 (Anthropic). 비어 있으면 `ant auth login` 프로필을 사용한다.
ANTHROPIC_API_KEY=

# LLM 추출 스위치. 기본은 꺼짐 — 돈이 나가는 곳은 추출 한 군데뿐이라(공고 1건 약 1,300원)
# 켜는 것을 명시적인 행동으로 둔다. 꺼져 있어도 수집·게시·검수·앱은 그대로 돈다.
EXTRACTION_ENABLED=false

# Kakao Local API (주소 → 좌표, 주변 역·정류장)
KAKAO_REST_API_KEY=

# 수집 범위 (비용 통제). 기관은 LH,SH / 지역은 시도 코드, 빈 값이면 전국
COLLECT_PROVIDERS=LH,SH
COLLECT_REGIONS=11,41

# 국토교통부 전월세 실거래가 (공공데이터포털). 비어 있으면 주변 시세를 건너뛴다
MOLIT_API_KEY=

# 마이홈포털 예비입주자 대기현황 (공공데이터포털). 비어 있으면 대기현황을 건너뛴다
MYHOME_API_KEY=

# K-apt 관리비 (공공데이터포털, 단지 목록·기본정보·공용관리비·개별사용료 4건 활용신청).
# 공공데이터포털 키는 계정당 하나라 MOLIT_API_KEY와 같다 — 비워 두면 MOLIT_API_KEY를 쓴다.
KAPT_API_KEY=

# 서울시 대중교통 환승경로 (공공데이터포털). 비어 있으면 통근을 직선거리로만 보여 준다
TRANSIT_API_KEY=
