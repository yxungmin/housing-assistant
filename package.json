{
  "name": "housing-assistant",
  "private": true,
  "version": "0.1.0",
  "description": "공공주택 비서 — LH 공고 매칭·주거비 계산 앱 모노레포",
  "workspaces": [
    "packages/*",
    "collector",
    "apps/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "schema:json": "npm run json-schema -w @housing/schema",
    "collect": "npm run collect -w @housing/collector",
    "inspect": "npm run inspect -w @housing/collector --",
    "lh:dump": "npm run lh:dump -w @housing/collector",
    "benchmark": "npm run benchmark -w @housing/collector --",
    "collect:dry": "npm run collect:dry -w @housing/collector",
    "review": "npm run review -w @housing/collector",
    "app:data": "npm run app:data -w @housing/collector",
    "app": "npm run start -w @housing/mobile",
    "app:icons": "npm run icon:preview -w @housing/mobile",
    "benchmark:fetch": "npm run benchmark:fetch -w @housing/collector --",
    "lh:stats": "npm run lh:stats -w @housing/collector",
    "benchmark:compare": "npm run benchmark:compare -w @housing/collector",
    "benchmark:rescore": "npm run benchmark:rescore -w @housing/collector --",
    "fixture:check": "npm run fixture:check -w @housing/collector --",
    "db:check": "bash supabase/test/run.sh",
    "app:enrich": "npm run app:enrich -w @housing/collector --",
    "simulate": "npm run simulate -w @housing/collector --",
    "audit:match": "npm run audit:match -w @housing/collector --",
    "pdf:rehost": "npm run pdf:rehost -w @housing/collector --",
    "output:size": "npm run output:size -w @housing/collector",
    "bundle:push": "npm run bundle:push -w @housing/collector --",
    "legal:site": "npm run legal:site -w @housing/mobile",
    "benchmark:restore": "npm run benchmark:restore -w @housing/collector",
    "backfill:complex": "npm run backfill:complex -w @housing/collector --"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@types/node": "^24.3.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vitest": "^3.2.0"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
